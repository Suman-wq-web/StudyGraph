# Base URL of the FastAPI backend. The frontend never talks to MongoDB or
# OpenAI directly -- all data/AI access goes through this API. No secrets
# belong in this file; only NEXT_PUBLIC_* values are exposed to the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google Sign-In (Phase 9). Same OAuth 2.0 "Web application" client as
# backend/.env.example's GOOGLE_CLIENT_ID -- must be the identical value.
# This is the client's public ID, not a secret, so it's safe in a
# NEXT_PUBLIC_ variable; the Client Secret is never used by this app and
# must never be placed in a NEXT_PUBLIC_ variable or any frontend file.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1001554368941-ifpn1s1ap1ldra003dmcvdtdolrnighc.apps.googleusercontent.com
