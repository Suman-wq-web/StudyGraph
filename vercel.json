{
    "services": {
      "frontend": {
        "root": "frontend",
        "framework": "nextjs"
      },
      "backend": {
        "root": "backend",
        "entrypoint": "main:app"
      }
    },
    "rewrites": [
      {
        "source": "/api/v1(/.*)?",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "frontend"
        }
      }
    ]
  }