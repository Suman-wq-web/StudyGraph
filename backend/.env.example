# MongoDB Atlas connection string (includes credentials -- never commit the real value).
# Vector search (Phase 4) requires a real Atlas cluster; a local `mongod` works for
# everything else (CRUD, chunking) but cannot run $vectorSearch queries -- see
# docs/DATABASE.md ("Atlas Vector Search setup").
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=studygraph

# Comma-separated list of origins allowed to call this API (CORS).
ALLOWED_ORIGINS=http://localhost:3000

# Document-processing pipeline (Phase 3) -- optional, these are the defaults.
# CHUNK_SIZE_TOKENS=512
# CHUNK_OVERLAP_TOKENS=64
# TIKTOKEN_ENCODING=cl100k_base

# Embeddings (Phase 4). Gemini is the embedding provider -- NOT OpenAI. Get a
# free-tier key at https://aistudio.google.com/apikey. Never exposed to the frontend.
GEMINI_API_KEY=AI...
# EMBEDDING_PROVIDER=gemini
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Leave unset to use the model's own default (3072 dims). Set to 768/1536/3072
# to truncate via Matryoshka Representation Learning -- must match whatever
# dimension the Atlas Vector Search index was created with.
# GEMINI_EMBEDDING_DIMENSIONS=768
# EMBEDDING_BATCH_SIZE=32

# Chat generation (Phase 5). Gemini is the generation provider too -- the
# same GEMINI_API_KEY above, same google-genai SDK client as embeddings, NOT
# a new SDK or a second key.
# GENERATION_PROVIDER=gemini
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_CHAT_TEMPERATURE=0.2
# GEMINI_CHAT_MAX_OUTPUT_TOKENS=1024

# Hybrid retrieval (Phase 5) -- optional, these are the defaults. See
# docs/RAG.md ("Why hybrid retrieval") and app/services/rag/retrieval.py.
# RAG_DEFAULT_TOP_K=8
# RAG_CANDIDATE_MULTIPLIER=4
# RAG_MIN_CANDIDATE_POOL=20
# RAG_RRF_K=60
# RAG_MAX_SNIPPET_CHARS=320

# Google Sign-In (Phase 9). Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials -- Authorized JavaScript
# origins must include your frontend's origin (e.g. http://localhost:3000);
# no redirect URI is needed (the ID-token/popup flow never redirects). Only
# the Client ID is needed here -- the backend verifies a Google-issued ID
# token's signature against Google's public keys, it never calls Google
# with the Client Secret, so the secret is NOT used or stored anywhere in
# this app. Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly
# (frontend/.env.local.example) -- both are the same OAuth client's public
# ID, not a secret.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
